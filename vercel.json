{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/cms",
      "destination": "https://saboteur-api.vercel.app/api/cms"
    },
    {
      "source": "/comics",
      "destination": "/comics.html"
    },
    {
      "source": "/facts",
      "destination": "/facts.html"
    },
    {
      "source": "/what-we-sell",
      "destination": "/facts.html"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/((?!api/|cms|assets/|fonts/|tokens/|robots\\.txt|sitemap\\.xml|llms\\.txt|llms-full\\.txt|comics\\.html|facts\\.html|favicon\\.ico).*)",
      "destination": "/api/page?__path=/$1"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.saboteur.one"
        }
      ],
      "destination": "https://saboteur.one/:path*",
      "statusCode": 301
    },
    {
      "source": "/store",
      "has": [
        {
          "type": "query",
          "key": "tab",
          "value": "comics"
        }
      ],
      "destination": "/store/comics",
      "statusCode": 301
    },
    {
      "source": "/store",
      "has": [
        {
          "type": "query",
          "key": "tab",
          "value": "prints-and-books"
        }
      ],
      "destination": "/store/books",
      "statusCode": 301
    },
    {
      "source": "/store",
      "has": [
        {
          "type": "query",
          "key": "tab",
          "value": "books"
        }
      ],
      "destination": "/store/books",
      "statusCode": 301
    },
    {
      "source": "/store",
      "has": [
        {
          "type": "query",
          "key": "tab",
          "value": "textures"
        }
      ],
      "destination": "/store/textures",
      "statusCode": 301
    },
    {
      "source": "/store",
      "has": [
        {
          "type": "query",
          "key": "tab",
          "value": "original-art"
        }
      ],
      "destination": "/store/original-art",
      "statusCode": 301
    },
    {
      "source": "/store",
      "has": [
        {
          "type": "query",
          "key": "tab",
          "value": "clothing"
        }
      ],
      "destination": "/store/apparel",
      "statusCode": 301
    },
    {
      "source": "/store",
      "has": [
        {
          "type": "query",
          "key": "tab",
          "value": "apparel"
        }
      ],
      "destination": "/store/apparel",
      "statusCode": 301
    }
  ],
  "functions": {
    "api/page.js": {
      "includeFiles": "index.html"
    },
    "api/sitemap.js": {
      "includeFiles": "index.html"
    }
  }
}
